{
  "entities": {
    "User": {
      "title": "User",
      "description": "Player profile holding level progression, coins balance, and scores.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth UID." },
        "displayName": { "type": "string", "description": "Player's display name." },
        "email": { "type": "string", "description": "Player's email address." },
        "photoUrl": { "type": "string", "description": "Profile picture URL." },
        "coins": { "type": "integer", "description": "Player's coin balance." },
        "currentLevel": { "type": "integer", "description": "Current selected or playing level." },
        "highestUnlockedLevel": { "type": "integer", "description": "Highest unlocked level (1 to 100)." },
        "totalScore": { "type": "integer", "description": "Cumulative game score." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." }
      },
      "required": ["uid", "displayName", "email", "coins", "currentLevel", "highestUnlockedLevel", "totalScore", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Admin UID." },
        "email": { "type": "string", "description": "Admin email." },
        "role": { "type": "string", "description": "Role string e.g. admin." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Record creation timestamp." }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Audit record of coins granted by an admin to a player.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction identifier." },
        "adminUid": { "type": "string", "description": "UID of the admin who granted coins." },
        "adminEmail": { "type": "string", "description": "Email of the admin." },
        "targetUid": { "type": "string", "description": "UID of player receiving coins." },
        "amount": { "type": "integer", "description": "Number of coins granted." },
        "note": { "type": "string", "description": "Optional note." },
        "timestamp": { "type": "string", "format": "date-time", "description": "Timestamp of transaction." }
      },
      "required": ["id", "adminUid", "adminEmail", "targetUid", "amount", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of player user profiles."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of administrator accounts."
    },
    "/coin_transactions/{transactionId}": {
      "schema": "CoinTransaction",
      "description": "History of admin coin grant transactions."
    }
  }
}
